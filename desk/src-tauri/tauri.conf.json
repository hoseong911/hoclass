{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "오늘, 교무노트",
  "mainBinaryName": "gyomu-note",
  "version": "0.3.0",
  "identifier": "com.hoseong.desk",
  "build": {
    "frontendDist": "https://hoseong911.github.io/hoclass/desk/"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
